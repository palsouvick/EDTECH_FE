# Everything prefixed VITE_ is compiled into the public JS bundle.
# Never put secrets in this file.

# Base path of the exam-engine API. Keep "/api/v1" in dev (Vite proxies it);
# set a full URL (https://api.example.com/api/v1) if the API is on another origin.
VITE_API_BASE_URL=/api/v1

# true = render the built-in Profit & Loss sheet without calling the backend.
VITE_USE_FIXTURES=false

# Daily practice goal shown in the progress tracker.
VITE_DAILY_GOAL=30

# Dev server only (not exposed to the browser).
VITE_DEV_PORT=5173
DEV_API_PROXY_TARGET=http://localhost:3000

# Dev builds only: sent as x-user-id so mock tests work without the auth stack.
# Production backends ignore it.
VITE_DEV_USER_ID=dev_student_1
